* {
  font-family: "JetBrainsMono Nerd Font Propo";
  font-size: 13px;
  font-weight: 500;
  border: none;
  border-radius: 0;
  box-shadow: none;
  text-shadow: none;
}

/* ---- windows ---- */
#swaync-notification-window {
  margin-top: 46px;
  background: transparent;
}

#swaync-control-center {
  margin-top: 46px;
  background-color: @surface0@;
  border: 2px solid @surface1@;
  border-radius: 16px;
  padding: 12px;
  box-shadow: 0 8px 32px 4px @shadow@;
}

/* ---- floating notifications ---- */
.notification-row {
  outline: none;
  margin: 6px 0;
}

.notification {
  background-color: @surface0@;
  border: 2px solid @surface1@;
  border-radius: 16px;
  padding: 12px 16px;
  box-shadow: 0 8px 32px 4px @shadow@;
  transition: all 0.3s ease-out;
}

.notification:hover {
  border-color: @blue@;
}

.notification.critical {
  border-color: @red@;
}

.notification .notification-icon {
  margin-right: 12px;
}

.notification image {
  background: transparent;
}

.notification label.title {
  color: @text@;
  font-weight: 700;
}

.notification label.time {
  color: @overlay0@;
  font-size: 12px;
}

.notification label.summary {
  color: @text@;
}

.notification label.body {
  color: @overlay0@;
}

.notification-action-row {
  background: transparent;
  margin-top: 8px;
}

.notification-action-button {
  background-color: @base@;
  border: 2px solid @surface1@;
  border-radius: 999px;
  color: @text@;
  padding: 4px 14px;
  transition: all 0.3s ease-out;
}

.notification-action-button:hover {
  border-color: @blue@;
  color: @blue@;
}

.close-button {
  background-color: @base@;
  border: 2px solid @surface1@;
  border-radius: 999px;
  color: @overlay0@;
  min-width: 24px;
  min-height: 24px;
  transition: all 0.3s ease-out;
}

.close-button:hover {
  border-color: @red@;
  color: @red@;
}

/* ---- grouped notifications ---- */
.notification-group {
  background-color: @surface0@;
  border: 2px solid @surface1@;
  border-radius: 16px;
  padding: 12px 16px;
  margin: 6px 0;
  box-shadow: 0 8px 32px 4px @shadow@;
  transition: all 0.3s ease-out;
}

.notification-group:hover {
  border-color: @blue@;
}

.notification-group-header {
  color: @text@;
  font-weight: 700;
}

.notification-group-header .notification-group-count {
  color: @overlay0@;
}

/* ---- control center ---- */
.control-center {
  background: transparent;
}

.control-center-title {
  color: @text@;
  font-size: 15px;
  font-weight: 700;
  padding: 4px 4px 8px 4px;
}

.control-center-title .clear-all-button {
  background-color: @base@;
  border: 2px solid @surface1@;
  border-radius: 999px;
  color: @overlay0@;
  padding: 2px 12px;
  transition: all 0.3s ease-out;
}

.control-center-title .clear-all-button:hover {
  border-color: @red@;
  color: @red@;
}

.control-center-dnd {
  background-color: @base@;
  border: 2px solid @surface1@;
  border-radius: 999px;
  color: @text@;
  padding: 4px 14px;
  margin-bottom: 10px;
  transition: all 0.3s ease-out;
}

.control-center-dnd:hover {
  border-color: @blue@;
}

.control-center-dnd label {
  color: @text@;
}

.control-center-dnd slider {
  background: @blue@;
  border-radius: 999px;
}

.control-center-list {
  background: transparent;
}

.control-center-list .empty-placeholder {
  color: @overlay0@;
}

.control-center-list .notification-group {
  margin: 6px 0;
}
