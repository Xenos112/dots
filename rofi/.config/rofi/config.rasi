@import "styles/rofi.rasi"
@import "styles/fonts.rasi"

configuration {
    modi: "drun,run,window";
    show-icons: true;
    display-drun: "";
    display-run: "";
    display-window: "";
    drun-display-format: "{name}";
    window-format: "{c}";
    icon-theme: "Papirus";
    terminal: "kitty";
    disable-history: false;
    sidebar-mode: false;
    cycle: true;
    scroll-method: 0;
    matching: "fuzzy";
    case-sensitive: false;
    sort: true;
    sorting-method: "fzf";
}

/* ============ macOS spotlight-style window ============ */
window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: false;
    width: 480px;
    enabled: true;
    margin: 0px;
    padding: 0px;
    border: 2px solid;
    border-radius: 16px;
    border-color: @border;
    background-color: @background;
    cursor: "default";
}

mainbox {
    enabled: true;
    spacing: 0px;
    margin: 0px;
    padding: 0px;
    border: 0px solid;
    border-radius: 14px;
    background-color: transparent;
    children: [ "inputbar", "listview" ];
}

/* ============ search ============ */
inputbar {
    enabled: true;
    spacing: 12px;
    margin: 0px;
    padding: 14px 20px;
    border: 0px solid;
    background-color: transparent;
    text-color: @foreground;
    children: [ "prompt", "entry" ];
}

prompt {
    enabled: true;
    padding: 0px;
    border-radius: 0px;
    background-color: transparent;
    text-color: @selected;
    font: "14";
}

entry {
    enabled: true;
    padding: 0px;
    border-radius: 0px;
    background-color: transparent;
    text-color: @foreground;
    cursor: text;
    placeholder: "Search…";
    placeholder-color: @dim;
    blink: true;
    font: "13";
}

/* ============ results ============ */
listview {
    enabled: true;
    columns: 1;
    lines: 8;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    reverse: false;
    fixed-height: false;
    fixed-columns: true;
    spacing: 0px;
    margin: 0px;
    padding: 0px;
    border: 1px 0 0 0;
    border-color: @border;
    background-color: transparent;
    text-color: @foreground;
    cursor: "default";
}

element {
    enabled: true;
    spacing: 16px;
    margin: 0px;
    padding: 10px 20px;
    border: 0px solid;
    border-radius: 0px;
    background-color: transparent;
    text-color: @foreground;
    orientation: horizontal;
    cursor: pointer;
}

element normal.normal {
    background-color: transparent;
    text-color: @foreground;
}

element normal.active {
    background-color: transparent;
    text-color: @selected;
}

element normal.urgent {
    background-color: transparent;
    text-color: @urgent;
}

element selected.normal {
    background-color: @selected;
    text-color: @selected-text;
}

element selected.active {
    background-color: @selected;
    text-color: @selected-text;
}

element selected.urgent {
    background-color: @urgent;
    text-color: @selected-text;
}

element alternate.normal {
    background-color: transparent;
    text-color: @foreground;
}

element-icon {
    background-color: transparent;
    text-color: inherit;
    size: 24px;
    cursor: inherit;
    margin: 0px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    highlight: bold;
    cursor: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.0;
    margin: 0px;
    font: "13";
}

/* ============ misc ============ */
message {
    enabled: true;
    margin: 0px;
    padding: 0px;
    border: 1px 0 0 0;
    border-color: @border;
    background-color: transparent;
    text-color: @foreground;
}

textbox {
    padding: 10px 20px;
    border: 0px;
    background-color: transparent;
    text-color: @foreground;
    vertical-align: 0.5;
    horizontal-align: 0.0;
}

error-message {
    padding: 12px 16px;
    border: 2px solid;
    border-radius: 12px;
    border-color: @urgent;
    background-color: @background;
    text-color: @urgent;
}
