/* Wallpaper picker — grid of thumbnails, no text, no search */

* {
    bg:        #0e0e12;
    bg-alt:    #16161c;
    fg:        #e6e6ea;
    fg-dim:    #8a8a93;
    accent:    #89b4fa;
    accent-bg: #2a2233;
    border:    #1f1f27;
    rounding:  16px;

    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 11";
}

window {
    transparency: "real";
    location:     center;
    anchor:       center;
    width:        60%;
    height:       60%;
    background-color: @bg;
    border:       1px solid;
    border-color: @border;
    border-radius: @rounding;
    padding:      18px;
    cursor:       "default";
}

mainbox {
    enabled:    true;
    children:   [ listview ];
    spacing:    0px;
    padding:    0px;
}

listview {
    enabled:        true;
    columns:        4;
    lines:          2;
    cycle:          true;
    dynamic:        false;
    scrollbar:      false;
    flow:           horizontal;
    fixed-height:   true;
    fixed-columns:  true;
    spacing:        14px;
    padding:        0px;
    margin:         0px;
    background-color: transparent;
    cursor:         "default";
}

element {
    enabled:        true;
    orientation:    vertical;
    padding:        8px;
    spacing:        0px;
    background-color: @bg-alt;
    border-radius:  12px;
    cursor:         pointer;
}

element normal.normal {
    background-color: @bg-alt;
    text-color:       @fg;
}

element selected.normal {
    background-color: @accent-bg;
    border:           2px solid;
    border-color:     @accent;
    text-color:       @fg;
}

element selected.urgent {
    background-color: @accent-bg;
    border:           2px solid;
    border-color:     @accent;
    text-color:       @urgent;
}

element selected.active {
    background-color: @accent-bg;
    border:           2px solid;
    border-color:     @accent;
    text-color:       @fg;
}

element-icon {
    enabled:            true;
    background-color:   transparent;
    size:               220px;
    horizontal-align:   0.5;
    vertical-align:     0.5;
    border-radius:      8px;
    cursor:             inherit;
    margin:             0px;
    padding:            0px;
}

element-text {
    enabled: false;
}

message {
    enabled:    true;
    padding:    0px;
    background-color: transparent;
}

textbox {
    padding:    0px;
    border:     0px;
    background-color: transparent;
}

error-message {
    padding:        50px;
    border-radius:  0px;
    background-color: @bg;
    text-color:     @urgent;
}
