@import "styles/rofi.rasi"
@import "styles/fonts.rasi"

/* ============================================================
   Theme picker (horizontal grid of theme cards)
   Usage: rofi -dmenu -theme themes.rasi
   ============================================================ */

window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: false;
    width: 920px;
    enabled: true;
    margin: 0px;
    padding: 0px;
    border: 2px solid;
    border-radius: 20px;
    border-color: @border;
    background-color: @background;
    cursor: "default";
}

mainbox {
    enabled: true;
    spacing: 0px;
    margin: 0px;
    padding: 16px;
    border: 0px solid;
    border-radius: 18px;
    background-color: transparent;
    children: [ "listview" ];
}

/* big square grid of theme icons */
listview {
    enabled: true;
    columns: 5;
    lines: 1;
    cycle: true;
    dynamic: false;
    scrollbar: false;
    layout: vertical;
    reverse: false;
    fixed-height: true;
    fixed-columns: true;
    spacing: 16px;
    margin: 0px;
    padding: 0px;
    border: 0px solid;
    background-color: transparent;
    text-color: @foreground;
    cursor: "default";
}

element {
    enabled: true;
    spacing: 0px;
    margin: 0px;
    padding: 34px;
    border: 0px solid;
    border-radius: 20px;
    background-color: @background-alt;
    text-color: @foreground;
    orientation: horizontal;
    cursor: pointer;
}

element normal.normal {
    background-color: @background-alt;
    text-color: @foreground;
}

element normal.urgent {
    background-color: @background-alt;
    text-color: @urgent;
}

element selected.normal {
    background-color: @selected;
    text-color: @selected-text;
}

element selected.urgent {
    background-color: @urgent;
    text-color: @selected-text;
}

element selected.active {
    background-color: @selected;
    text-color: @selected-text;
}

element-icon {
    background-color: transparent;
    text-color: inherit;
    size: 96px;
    cursor: inherit;
    margin: 0px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

element-text {
    enabled: false;
    background-color: transparent;
    text-color: inherit;
    highlight: bold;
    cursor: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.5;
    margin: 0px;
    font: "13";
}

message {
    enabled: true;
    margin: 8px 0px 0px 0px;
    padding: 10px 16px;
    border: 0px solid;
    border-radius: 10px;
    background-color: @background-alt;
    text-color: @foreground;
}

textbox {
    padding: 0px;
    border: 0px;
    background-color: transparent;
    text-color: @foreground;
    vertical-align: 0.5;
    horizontal-align: 0.0;
}

error-message {
    padding: 12px 16px;
    border: 2px solid;
    border-radius: 12px;
    border-color: @urgent;
    background-color: @background;
    text-color: @urgent;
}
